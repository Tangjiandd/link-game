.page-shell { min-height: 100vh; padding: 36rpx 36rpx 48rpx; box-sizing: border-box; background: linear-gradient(#e7f9fb, #fff7de 48%, #fff0c7); }
.levels-screen { text-align: center; }.welcome-icons { display: flex; align-items: center; justify-content: center; gap: 24rpx; height: 170rpx; font-size: 100rpx; }.welcome-icons text:nth-child(2) { margin-top: -32rpx; font-size: 76rpx; }.title { margin-top: 10rpx; font-size: 58rpx; font-weight: 700; }.subtitle { margin-top: 14rpx; color: #5d6874; font-size: 30rpx; }.level-list { display: flex; gap: 18rpx; margin-top: 64rpx; }.level-card { position: relative; flex: 1; min-width: 0; height: 330rpx; padding: 25rpx 8rpx; border: 4rpx solid #eadfca; border-radius: 14rpx; background: rgba(255,255,255,.9); box-shadow: 0 8rpx 0 rgba(115,93,58,.12); color: #29313d; line-height: 1.3; }.locked { opacity: .55; }.level-number,.level-info { display: block; color: #64717b; font-size: 24rpx; }.level-icon { display: block; margin: 22rpx 0 14rpx; font-size: 82rpx; }.level-title { display: block; font-size: 31rpx; font-weight: 700; }.level-info { margin-top: 10rpx; }.lock { position: absolute; top: 18rpx; right: 18rpx; font-size: 32rpx; }.parent-note { margin-top: 42rpx; color: #7d7160; font-size: 25rpx; }
.game-screen { padding-top: 18rpx; }.game-info { margin-bottom: 22rpx; }.game-heading { display: flex; align-items: center; gap: 18rpx; }.level-badge { padding: 7rpx 14rpx; border-radius: 8rpx; background: #ffd95a; font-size: 25rpx; font-weight: 700; }.game-title { font-size: 38rpx; font-weight: 700; }.progress-track { height: 20rpx; margin: 20rpx 0 11rpx; overflow: hidden; border-radius: 10rpx; background: #e2e7dc; }.progress-fill { height: 100%; border-radius: 10rpx; background: #87d7ba; transition: width .2s; }.match-count { color: #5d6874; font-size: 27rpx; }
.board { display: grid; gap: 14rpx; padding: 20rpx; border: 4rpx solid #e2d5bb; border-radius: 14rpx; background: #fffcf5; box-shadow: inset 0 0 0 8rpx rgba(255,255,255,.78),0 8rpx 0 rgba(115,93,58,.1); }.tile { width: 100%; aspect-ratio: 1; padding: 0; border: 4rpx solid #fff; border-radius: 13rpx; box-shadow: 0 7rpx 0 rgba(47,89,68,.17); font-size: 66rpx; line-height: 1; }.tile-0 { background: #d6eecf; }.tile-1 { background: #ffdab9; }.tile-2 { background: #cdebf5; }.tile-3 { background: #f7d1e1; }.tile.selected { border-color: #ff746b; transform: translateY(-6rpx) scale(1.04); }.tile.empty { visibility: hidden; }.tile.hint { animation: nudge .65s ease-in-out 2; }.hint-text { min-height: 48rpx; margin: 25rpx 0 18rpx; text-align: center; color: #596673; font-size: 29rpx; font-weight: 600; }.action-row { display: flex; justify-content: center; gap: 18rpx; }.secondary-button,.primary-button { min-height: 84rpx; padding: 0 30rpx; border-radius: 13rpx; font-weight: 700; }.secondary-button { border: 3rpx solid #eadfca; background: rgba(255,255,255,.82); color: #29313d; font-size: 28rpx; }.primary-button { min-width: 260rpx; background: #ff746b; color: #fff; font-size: 33rpx; }
.overlay { position: fixed; z-index: 10; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; padding: 48rpx; background: rgba(39,49,61,.28); }.celebration { width: 100%; padding: 54rpx 42rpx 40rpx; border: 5rpx solid #fff; border-radius: 14rpx; background: #fffaf0; text-align: center; box-shadow: 0 20rpx 0 rgba(43,55,67,.18); }.confetti { font-size: 42rpx; }.big-face { font-size: 130rpx; }.complete-title { margin-top: 8rpx; font-size: 60rpx; font-weight: 700; }.complete-text { margin: 14rpx 0 30rpx; color: #5c6975; font-size: 31rpx; }.text-button { margin-top: 20rpx; border: 0; background: transparent; color: #5f6c78; font-size: 28rpx; text-decoration: underline; }
@keyframes nudge { 0%,100% { transform: scale(1); } 50% { transform: scale(1.1); border-color: #ffd95a; } }
